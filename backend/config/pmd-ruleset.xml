<?xml version="1.0" encoding="UTF-8"?>
<!-- PMD rules for Project Pulse: PMD's quickstart set, minus the rules the team has decided not to
     enforce. To drop a rule, add an exclude inside the quickstart reference, with a comment giving
     the reason, for example:

       <exclude name="ControlStatementBraces"/>

     To add a rule from outside quickstart, add its own <rule ref="category/java/..."/> line.
     Every change here is a reviewed decision. -->
<ruleset name="Project Pulse"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD quickstart, with Project Pulse's decisions.</description>
    <rule ref="rulesets/java/quickstart.xml">
        <!-- D4: every flagged log call already uses SLF4J {} placeholders, so no message string is built unless that level is enabled; the only unguarded work is cheap getters such as getEmail() and size(). An isXEnabled() guard around each call would add clutter for no measurable saving. -->
        <exclude name="GuardLogStatement"/>
        <!-- D3: every flagged control statement is a one-line guard written on a single line and ending in a semicolon, such as if (team == null) return; The risk the rule guards against, a second indented statement that looks inside an unbraced body, cannot occur in that form. -->
        <exclude name="ControlStatementBraces"/>
        <!-- D2: every flagged empty constructor is the no-arg constructor JPA (26 entities) or Jackson/reflection (4 DTOs) needs. Writing it out is deliberate: if a second constructor is added later, an implicit no-arg constructor disappears and JPA fails at runtime. -->
        <exclude name="UncommentedEmptyConstructor"/>
        <exclude name="UnnecessaryConstructor"/>
    </rule>
</ruleset>
